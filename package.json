{
  "name": "botc-scenario-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "data:roles": "node scripts/fetch-roles.mjs",
    "data:assets": "node scripts/fetch-assets.mjs",
    "data:icons": "node scripts/fetch-icons.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sharp": "^0.35.1"
  }
}
