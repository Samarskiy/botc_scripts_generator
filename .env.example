# Copy to .env and fill in. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# PORT=5174
# Strongest by default. Cheaper alternatives: claude-sonnet-5, claude-sonnet-4-6
# BOTC_MODEL=claude-opus-5
# BOTC_BALANCE_THRESHOLD=8.0
# BOTC_MAX_ITERATIONS=2
# BOTC_AUTO_REPAIR_ATTEMPTS=2
